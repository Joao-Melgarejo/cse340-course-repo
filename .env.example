PORT=3000
NODE_ENV=development
# Use the External Database URL locally, Internal Database URL on Render.
DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ENABLE_SQL_LOGGING=true
# Keep true unless a confirmed certificate issue requires the course workaround.
DB_SSL_REJECT_UNAUTHORIZED=true

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_PRIVATE_SECRET

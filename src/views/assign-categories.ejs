<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <h2><%= projectDetails.title %></h2>
    <form action="/assign-categories/<%= projectId %>" method="POST" class="data-form">
        <fieldset>
            <legend>Choose project categories</legend>
            <p>Leave every checkbox unchecked to remove all category assignments.</p>
            <% if (categories.length === 0) { %>
                <p>No categories are available yet.</p>
            <% } %>
            <% categories.forEach(category => { %>
                <div class="checkbox-row">
                    <input type="checkbox" id="category-<%= category.category_id %>" name="categoryIds" value="<%= category.category_id %>" <%= assignedCategories.some(ac => Number(ac.category_id) === Number(category.category_id)) ? 'checked' : '' %>>
                    <label for="category-<%= category.category_id %>"><%= category.name %></label>
                </div>
            <% }); %>
        </fieldset>
        <button type="submit">Update Categories</button>
    </form>
    <p class="back-link"><a href="/project/<%= projectId %>">Cancel</a></p>
</main>
<%- include('partials/footer') %>

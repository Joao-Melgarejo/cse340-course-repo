<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <p><a href="/new-category">Add New Category</a></p>
    <% if (categories.length === 0) { %>
        <p>No service project categories are available yet.</p>
    <% } else { %>
        <ul class="categories">
            <% categories.forEach(category => { %>
                <li><h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2></li>
            <% }); %>
        </ul>
    <% } %>
</main>
<%- include('partials/footer') %>

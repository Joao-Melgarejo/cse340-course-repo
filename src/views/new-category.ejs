<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <form action="/new-category" method="POST" class="data-form">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input type="text" id="name" name="name" maxlength="100" required value="<%= name %>" aria-describedby="name-help">
            <small id="name-help">Required. Use 3 to 100 characters.</small>
        </div>
        <button type="submit">Create Category</button>
    </form>
    <p class="back-link"><a href="/categories">Cancel</a></p>
</main>
<%- include('partials/footer') %>

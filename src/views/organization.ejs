<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <h2><%= organizationDetails.name %></h2>
    <img class="organization-logo" src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo" width="120">
    <p><%= organizationDetails.description %></p>
    <p><strong>Contact:</strong> <a href="mailto:<%= organizationDetails.contact_email %>"><%= organizationDetails.contact_email %></a></p>
    <h2>Service Projects</h2>
    <% if (projects.length === 0) { %>
        <p>This organization has no service projects yet.</p>
    <% } else { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                    <p><time datetime="<%= project.date %>"><%= new Date(project.date + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></time></p>
                </li>
            <% }); %>
        </ul>
    <% } %>
    <p class="back-link"><a href="/organizations">Back to all organizations</a></p>
</main>
<%- include('partials/footer') %>

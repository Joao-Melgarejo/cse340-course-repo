<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" class="data-form">
    <p>All fields are required. The organization name must contain 3 to 150 characters.</p>
    <div class="form-group">
        <label for="name">Organization Name</label>
        <input type="text" id="name" name="name" maxlength="150" required value="<%= organizationDetails.name %>">
    </div>
    <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" maxlength="500" required rows="5"><%= organizationDetails.description %></textarea>
    </div>
    <div class="form-group">
        <label for="contactEmail">Contact Email</label>
        <input type="email" id="contactEmail" name="contactEmail" maxlength="255" required value="<%= organizationDetails.contact_email %>">
    </div>
    <div class="form-group">
        <label for="logoFilename">Logo Filename</label>
        <input type="text" id="logoFilename" name="logoFilename" maxlength="255" required value="<%= organizationDetails.logo_filename %>" aria-describedby="logo-help">
        <small id="logo-help">Enter a filename already in public/images, such as placeholder-logo.png. File uploads are not supported.</small>
    </div>
    <button type="submit">Update Organization</button>
    </form>
    <p class="back-link"><a href="/organization/<%= organizationDetails.organization_id %>">Cancel</a></p>
</main>
<%- include('partials/footer') %>

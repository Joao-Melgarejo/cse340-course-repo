<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <% if (organizations.length === 0) { %>
        <p>Create an organization before adding a service project. <a href="/new-organization">Add an organization</a></p>
    <% } else { %>
    <form action="/edit-project/<%= project.project_id %>" method="POST" class="data-form">
        <p>All fields are required. The project title must contain 3 to 150 characters.</p>
        <div class="form-group">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" maxlength="150" required value="<%= project.title %>">
        </div>
        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" maxlength="1000" required rows="5"><%= project.description %></textarea>
        </div>
        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" maxlength="200" required value="<%= project.location %>">
        </div>
        <div class="form-group">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" required value="<%= project.date %>">
        </div>
        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">Select an organization</option>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>" <%= Number(org.organization_id) === Number(project.organization_id) ? "selected" : "" %>><%= org.name %></option>
                <% }); %>
            </select>
        </div>
        <button type="submit">Update Project</button>
    </form>
    <% } %>
    <p class="back-link"><a href="/project/<%= project.project_id %>">Cancel</a></p>
</main>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <p>Meet our partner organizations and find out how to contact them:</p>
    <% if (organizations.length === 0) { %>
        <p>No partner organizations are available yet.</p>
    <% } else { %>
        <ul class="organizations">
            <% organizations.forEach(organization => { %>
                <li>
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" width="100">
                    <div>
                        <h2><%= organization.name %></h2>
                        <p><%= organization.description %></p>
                        <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
                    </div>
                </li>
            <% }); %>
        </ul>
    <% } %>
</main>
<%- include('partials/footer') %>

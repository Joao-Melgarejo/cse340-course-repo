<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <p>The next five service projects, starting today. Select a project to see its details.</p>
    <% if (projects.length === 0) { %>
        <p>No upcoming service projects are available yet.</p>
    <% } else { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
                    <p><time datetime="<%= project.date %>"><%= new Date(project.date + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></time></p>
                    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
                    <p><%= project.description %></p>
                    <p><strong>Location:</strong> <%= project.location %></p>
                </li>
            <% }); %>
        </ul>
    <% } %>
</main>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<main id="main-content" tabindex="-1">
    <h1><%= title %></h1>
    <h2>Service Project Schedule</h2>
    <% if (projects.length === 0) { %>
        <p>No service projects are available yet.</p>
    <% } else { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <h2><time datetime="<%= project.date %>"><%= new Date(project.date + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></time>: <%= project.title %> (<%= project.organization_name %>)</h2>
                    <p><%= project.description %></p>
                    <p><strong>Location:</strong> <%= project.location %></p>
                </li>
            <% }); %>
        </ul>
    <% } %>
</main>
<%- include('partials/footer') %>
